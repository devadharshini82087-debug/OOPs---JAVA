import java.util.*;

interface Calculator {
    int add(int n1, int n2);
    int sub(int n1, int n2);
    int mult(int n1, int n2);
    int div(int n1, int n2);
}

class Operation implements Calculator {
    public int add(int n1, int n2) {
        return n1 + n2;
    }

    public int sub(int n1, int n2) {
        return n1 - n2;
    }

    public int mult(int n1, int n2) {
        return n1 * n2;
    }

    public int div(int n1, int n2) {
        return n1 / n2;
    }
}

public class Ex5 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        Operation o = new Operation();

        int n1, n2;

        System.out.println("TEST CASE 1 - ADDITION");
        System.out.print("First Number: ");
        n1 = sc.nextInt();
        System.out.print("Second Number: ");
        n2 = sc.nextInt();
        System.out.println("Result = " + o.add(n1, n2));
        System.out.println("-------------");

        System.out.println("TEST CASE 2 - SUBTRACTION");
        System.out.print("First Number: ");
        n1 = sc.nextInt();
        System.out.print("Second Number: ");
        n2 = sc.nextInt();
        System.out.println("Result = " + o.sub(n1, n2));
        System.out.println("-------------");

        System.out.println("TEST CASE 3 - MULTIPLICATION");
        System.out.print("First Number: ");
        n1 = sc.nextInt();
        System.out.print("Second Number: ");
        n2 = sc.nextInt();
        System.out.println("Result = " + o.mult(n1, n2));
        System.out.println("-------------");

        System.out.println("TEST CASE 4 - DIVISION");
        System.out.print("First Number: ");
        n1 = sc.nextInt();
        System.out.print("Second Number: ");
        n2 = sc.nextInt();

        if (n2 != 0)
            System.out.println("Result = " + o.div(n1, n2));
        else
            System.out.println("Division by zero is not allowed.");

        System.out.println("-------------");

        sc.close();
    }
}
